@page
@model PrivacyModel
@{
    ViewData["Title"] = "Политика конфиденциальности";
    // Отключаем стандартный белый шаблон, чтобы применить нашу темную тему
    Layout = null; 
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BDApp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        /* --- НАША ФИРМЕННАЯ ГРАФИТОВАЯ ПАЛИТРА --- */
        :root {
            --bd-bg: #121214;         /* Глубокий темный фон */
            --bd-card: #1c1c1f;       /* Темно-серый для карточек и шапки */
            --bd-border: #2d2d33;     /* Темно-серые границы */
            --bd-text: #ffffff;       /* Чисто белый текст */
            --bd-text-muted: #c4c4c8; /* Светло-серый текст */
            --bd-accent: #ffffff;     /* Белый акцент */
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: var(--bd-bg);
            color: var(--bd-text);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Навигация (копия с главной страницы) */
        .navbar-bd {
            background-color: var(--bd-card);
            border-bottom: 1px solid var(--bd-border);
        }
        .navbar-bd .navbar-brand { color: var(--bd-text); font-weight: bold; letter-spacing: 1px; }
        .navbar-bd .nav-link { color: var(--bd-text-muted); transition: color 0.2s; }
        .navbar-bd .nav-link:hover { color: var(--bd-accent); text-shadow: 0 0 8px rgba(255,255,255,0.3); }

        /* Иконка в шапке */
        .mono-icon {
            filter: grayscale(100%) contrast(200%) brightness(150%);
        }

        /* Оформление панели с текстом документа */
        .document-card {
            background-color: var(--bd-card);
            border: 1px solid var(--bd-border);
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        /* Подвал */
        footer {
            border-top: 1px solid var(--bd-border);
            background-color: var(--bd-bg);
            color: var(--bd-text-muted);
            margin-top: auto;
        }
        footer a { color: var(--bd-text-muted); text-decoration: none; transition: color 0.2s;}
        footer a:hover { color: var(--bd-text); }
    </style>
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-bd mb-5 py-3">
            <div class="container">
                <a class="navbar-brand mono-icon" href="/">🏗️ BDApp</a>
                <div class="d-flex justify-content-between flex-grow-1">
                    <ul class="navbar-nav flex-row gap-4">
                        <li class="nav-item"><a class="nav-link" href="/">Главная</a></li>
                        <li class="nav-item"><a class="nav-link" style="color: var(--bd-accent);" href="/Privacy">Конфиденциальность</a></li>
                    </ul>
                    <ul class="navbar-nav flex-row gap-4">
                        <li class="nav-item"><a class="nav-link" href="/Identity/Account/Register">Регистрация</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Identity/Account/Login">Вход</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container flex-grow-1 mb-5">
        
        <div class="document-card p-5">
            <h1 class="fw-bold mb-4" style="color: var(--bd-text);">@ViewData["Title"]</h1>
            
            <div style="color: var(--bd-text-muted); line-height: 1.8;">
                <p>
                    На этой странице вы можете подробно описать политику конфиденциальности вашего проекта. 
                    Этот текст является примером того, как будет выглядеть реальный юридический документ в вашей системе.
                </p>

                <h4 class="fw-bold mt-5 mb-3" style="color: var(--bd-text);">1. Сбор информации</h4>
                <p>
                    Мы собираем информацию, когда вы регистрируетесь на сайте, заходите в свой аккаунт, 
                    участвуете в проекте и/или выходите из аккаунта. Информация включает ваше имя, адрес электронной почты, номер телефона и данные по объектам.
                </p>

                <h4 class="fw-bold mt-4 mb-3" style="color: var(--bd-text);">2. Использование информации</h4>
                <p>
                    Любая предоставленная вами информация может быть использована для:
                </p>
                <ul>
                    <li>Настройки вашего опыта под ваши нужды</li>
                    <li>Улучшения нашего приложения</li>
                    <li>Улучшения качества обслуживания пользователей</li>
                    <li>Организации проектной документации</li>
                </ul>
            </div>
        </div>

    </main>

    <footer class="py-4 text-center">
        <div class="container">
            &copy; 2026 - BDApp - <a href="/Privacy">Политика конфиденциальности</a>
        </div>
    </footer>

</body>
</html>