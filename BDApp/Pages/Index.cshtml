@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BDApp - Строим вместе</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        /* --- ПАЛИТРА --- */
        :root {
            --bd-bg: #121214;         /* Глубокий темный фон, почти черный */
            --bd-card: #1c1c1f;       /* Тот самый серый для карточек и шапки */
            --bd-border: #2d2d33;     /* Темно-серые границы */
            --bd-text: #ffffff;       /* Чисто белый текст */
            --bd-text-muted: #c4c4c8; /* Светло-серый текст, чтобы не сливался */
            --bd-accent: #ffffff;     /* Белый акцент */
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: var(--bd-bg);
            color: var(--bd-text);
        }

        /* Навигация */
        .navbar-bd {
            background-color: var(--bd-card); /* Серый цвет для шапки */
            border-bottom: 1px solid var(--bd-border);
        }
        .navbar-bd .navbar-brand { color: var(--bd-text); font-weight: bold; letter-spacing: 1px; }
        .navbar-bd .nav-link { color: var(--bd-text-muted); transition: color 0.2s; }
        .navbar-bd .nav-link:hover { color: var(--bd-accent); text-shadow: 0 0 8px rgba(255,255,255,0.3); }

        /* Баннер с переливанием */
        .hero-banner {
            /* Темно-серый градиент */
            background: linear-gradient(135deg, #222226 0%, #161619 100%);
            border-radius: 8px;
            border: 1px solid var(--bd-border);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            transition: all 0.4s ease;
        }

        /* Эффект при наведении: градиент становится светлее (более серым) */
        .hero-banner:hover {
            background: linear-gradient(135deg, #2c2c32 0%, #1f1f24 100%);
            border-color: #4a4a52;     
            box-shadow: 0 10px 40px rgba(255, 255, 255, 0.05); 
        }

        /* Кнопка: прозрачная -> белая */
        .btn-bd-primary {
            background-color: transparent;
            color: var(--bd-accent);
            font-weight: bold;
            border: 2px solid var(--bd-accent);
            border-radius: 4px;
            transition: all 0.3s ease;
        }
        .btn-bd-primary:hover { 
            background-color: var(--bd-accent); 
            color: #000000; /* Текст становится черным на белом фоне */
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
            transform: translateY(-2px); 
        }

        /* Карточки внизу */
        .feature-card {
            border: 1px solid var(--bd-border);
            border-radius: 8px;
            background-color: var(--bd-card); /* Серый фон */
            transition: all 0.3s ease;
        }
        .feature-card:hover { 
            transform: translateY(-8px); 
            border-color: #5a5a63;       
            box-shadow: 0 15px 30px rgba(0,0,0,0.7), 0 0 15px rgba(255, 255, 255, 0.03); 
        }
        
        /* Защита текста: жестко белый и светло-серый */
        .feature-card .card-title { color: #ffffff !important; }
        .feature-card .card-text { color: var(--bd-text-muted) !important; }

        /* Иконки */
        .mono-icon {
            filter: grayscale(100%) contrast(200%) brightness(150%);
        }

        /* Подвал */
        footer {
            border-top: 1px solid var(--bd-border);
            background-color: var(--bd-bg);
            color: var(--bd-text-muted);
            margin-top: auto;
        }
        footer a { color: var(--bd-text-muted); text-decoration: none; transition: color 0.2s;}
        footer a:hover { color: var(--bd-text); }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-sm navbar-bd mb-5 py-3">
            <div class="container">
                <a class="navbar-brand mono-icon" href="/">🏗️ BDApp</a>
                <div class="d-flex justify-content-between flex-grow-1">
                    <ul class="navbar-nav flex-row gap-4">
                        <li class="nav-item"><a class="nav-link" href="/">Главная</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Privacy">Конфиденциальность</a></li>
                    </ul>
                    <ul class="navbar-nav flex-row gap-4">
                        <li class="nav-item"><a class="nav-link" href="/Identity/Account/Register">Регистрация</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Identity/Account/Login">Вход</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container flex-grow-1">
        
        <div class="text-center mb-5">
            <h1 class="display-4 fw-bold">Добро пожаловать в BDApp</h1>
            <h4 class="mt-3" style="color: var(--bd-text-muted);">Система управления строительными объектами</h4>
        </div>

        <div class="hero-banner p-5 text-center mb-5">
            <h2 class="mb-3 fw-bold" style="color: #ffffff;">Надежная база данных для вашего строительства</h2>
            <h5 class="mb-5" style="color: var(--bd-text-muted);">Точный контроль на каждом этапе</h5>
            <a href="/Projects" class="btn btn-bd-primary btn-lg px-5 py-3 text-uppercase tracking-wide">Начать работу</a>
        </div>

        <div class="row g-4 text-center justify-content-center mb-5">
            <div class="col-md-4">
                <div class="card feature-card h-100 p-4">
                    <div class="card-body">
                        <h3 class="mono-icon mb-3">📂</h3>
                        <h5 class="card-title fw-bold">Центр объектов</h5>
                        <p class="card-text mt-3">Единое и защищенное хранилище для всей проектной документации.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feature-card h-100 p-4">
                    <div class="card-body">
                        <h3 class="mono-icon mb-3">⚙️</h3>
                        <h5 class="card-title fw-bold">Планирование</h5>
                        <p class="card-text mt-3">Четкое отслеживание сроков и контроль выполнения задач.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feature-card h-100 p-4">
                    <div class="card-body">
                        <h3 class="mono-icon mb-3">📊</h3>
                        <h5 class="card-title fw-bold">Аналитика</h5>
                        <p class="card-text mt-3">Детальные отчеты для принятия обоснованных управленческих решений.</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="py-4 text-center mt-auto">
        <div class="container">
            &copy; 2026 - BDApp - <a href="/Privacy">Политика конфиденциальности</a>
        </div>
    </footer>
</body>
</html>
