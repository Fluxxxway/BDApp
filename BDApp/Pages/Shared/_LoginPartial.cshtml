@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav flex-row gap-4 m-0 p-0">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link" style="color: var(--bd-accent);" asp-area="Identity" asp-page="/Account/Manage/Index" title="Профиль">Привет, @User.Identity?.Name!</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link" style="color: var(--bd-text-muted); border: none; padding-top: 8px;">Выйти</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" style="color: var(--bd-text-muted);" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" style="color: var(--bd-text-muted);" asp-area="Identity" asp-page="/Account/Login">Вход</a>
    </li>
}
</ul>